# Server-only Arkjet analytics origin. Never expose this value to browser code.
ARKJET_ANALYTICS_API_URL=http://127.0.0.1:8096/analytics/v1
ARKJET_ANALYTICS_TIMEOUT_MS=10000

# Optional browser path override. The default uses the SolidStart proxy routes.
VITE_ARKJET_ANALYTICS_API_URL=/api/arkjet-analytics

# Existing public WS gateway. Analytics subscribes to arkjet:analytics and
# silently revalidates authoritative projections when a fact is published.
VITE_ARKJET_ANALYTICS_WS_URL=ws://127.0.0.1:8100
